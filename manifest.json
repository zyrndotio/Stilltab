{
  "manifest_version": 3,
  "name": "Stilltab — A quieter new tab",
  "version": "0.7.0",
  "description": "A calm, customizable new tab for Firefox with local-first widgets and user-controlled external requests. No analytics or cookie access.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.alphavantage.co/*",
    "https://api.coingecko.com/*",
    "https://*/*"
  ],
  "icons": {
    "32": "icons/stilltab-32.png",
    "48": "icons/stilltab-48.png",
    "64": "icons/stilltab-64.png",
    "96": "icons/stilltab-96.png",
    "128": "icons/stilltab-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stilltab@local.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": [
          "authenticationInfo",
          "financialAndPaymentInfo",
          "locationInfo",
          "personalCommunications",
          "personallyIdentifyingInfo",
          "searchTerms",
          "websiteActivity"
        ]
      }
    }
  }
}
