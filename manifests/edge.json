{
  "manifest_version": 3,
  "name": "Stilltab — A quieter new tab",
  "version": "0.8.0",
  "description": "A calm, customizable new tab for Microsoft Edge with local-first widgets and user-controlled external requests. No analytics or cookie access.",
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "action": {
    "default_title": "Save current tab to Stilltab",
    "default_popup": "popup/index.html",
    "default_icon": {
      "32": "assets/icons/stilltab-32.png",
      "48": "assets/icons/stilltab-48.png",
      "128": "assets/icons/stilltab-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "favicon"
  ],
  "optional_host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.alphavantage.co/*",
    "https://api.coingecko.com/*",
    "https://*/*"
  ],
  "icons": {
    "32": "assets/icons/stilltab-32.png",
    "48": "assets/icons/stilltab-48.png",
    "64": "assets/icons/stilltab-64.png",
    "96": "assets/icons/stilltab-96.png",
    "128": "assets/icons/stilltab-128.png"
  }
}
